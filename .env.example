# Configuration de la base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oms_database
DB_USER=postgres
DB_PASSWORD=password

# Configuration du serveur
PORT=3000
NODE_ENV=development

# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SHOP_NAME=your-shop-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token

# WooCommerce Configuration
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# Adobe Commerce (Magento) Configuration
ADOBE_COMMERCE_URL=https://your-magento-store.com
ADOBE_COMMERCE_ACCESS_TOKEN=your_access_token

# PrestaShop Configuration
PRESTASHOP_URL=https://your-prestashop-store.com
PRESTASHOP_API_KEY=your_prestashop_api_key

# Synchronisation automatique (en minutes)
SYNC_INTERVAL=15
